# DESIGN.md Bölüm 3 — PostgreSQL bağlantısı
DATABASE_URL="postgresql://tegrai:tegrai_dev_password@localhost:5432/tegrai?schema=public"

# app/
PORT=3000

# TODO: AI provider API key şifreleme anahtarı (DESIGN.md 4.1 api_key_encrypted)
ENCRYPTION_KEY=

# JWT imzalama anahtarı (DESIGN.md 8 — Auth mekanizması). 32 byte hex önerilir:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# mcp-server/ — sadece localhost'ta çalışan internal HTTP API (bkz. DESIGN.md 3/7/8).
# app/ bu servise bu sırla kimlik kanıtlar; rastgele bir değer yeterli:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_PORT=3100
MCP_INTERNAL_SECRET=

# LDAP entegrasyonu (DESIGN.md 8, karar 170) — opsiyonel. LDAP_URL/LDAP_BASE_DN tanımlı
# değilse LDAP login tamamen devre dışıdır, sadece `local` kullanıcılar login olabilir.
# LDAP_BIND_DN/LDAP_BIND_PASSWORD boşsa arama anonim bind ile yapılır.
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# {{input}} yerine login'de girilen email konur. Active Directory için ör.
# "(userPrincipalName={{input}})" veya "(sAMAccountName={{input}})" kullanılabilir.
LDAP_USER_SEARCH_FILTER=(mail={{input}})
LDAP_EMAIL_ATTR=mail
LDAP_FULLNAME_ATTR=displayName
